{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kulturradar/data.schema.json",
  "title": "Kulturradar Daten",
  "$defs": {
    "source": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {"label": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}},
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "required": ["date", "time"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "time": {"type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}( \\+ \\d{2}:\\d{2})*$"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "title", "text", "when", "dates", "range", "venue", "city", "sparte", "cat", "region", "status", "statusNote", "free", "discount", "premiere", "soldOut", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1, "description": "Nur der Werktitel"},
        "artist": {"type": "string", "description": "Kompanie, Choreograf:in, Komponist"},
        "text": {"type": "string", "description": "Vollständige Beschreibung, Markdown mit Links"},
        "when": {"type": "string", "description": "Datumsangabe als lesbarer Text"},
        "dates": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
        "range": {
          "type": ["object", "null"],
          "properties": {"start": {"type": ["string", "null"]}, "end": {"type": "string"}},
          "required": ["end"]
        },
        "venue": {"type": "string"},
        "city": {"type": "string"},
        "sparte": {"type": "string"},
        "cat": {"enum": ["dance", "ballet", "workshop", "probe", "opera", "theatre", "music", "social", "tour", "festival", "art", "other"]},
        "region": {"enum": ["bologna", "er", "trip"]},
        "status": {"enum": ["ok", "check", "partial", "cancel"]},
        "statusNote": {"type": "string"},
        "cancelledAt": {"type": "string"},
        "free": {"type": "boolean"},
        "discount": {"type": "boolean"},
        "premiere": {"type": "boolean"},
        "soldOut": {"enum": ["full", "few", null]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
        "lastChecked": {"type": "string", "description": "Datum der letzten Prüfung an der Quelle"}
      },
      "additionalProperties": false
    },
    "deadline": {
      "type": "object",
      "required": ["id", "date", "kind", "label", "title", "text", "status", "statusNote", "trip", "free", "discount", "sources"],
      "properties": {
        "id": {"type": "string"},
        "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "kind": {"enum": ["date", "until", "outlook", "ongoing"]},
        "label": {"type": "string"},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "status": {"enum": ["ok", "check", "partial", "cancel"]},
        "statusNote": {"type": "string"},
        "trip": {"type": "boolean"},
        "free": {"type": "boolean"},
        "discount": {"type": "boolean"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "required": ["updated", "events"],
      "properties": {"updated": {"type": "string"}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}},
      "additionalProperties": false
    },
    "deadlines": {
      "type": "object",
      "required": ["updated", "deadlines"],
      "properties": {"updated": {"type": "string"}, "deadlines": {"type": "array", "items": {"$ref": "#/$defs/deadline"}}},
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["version", "lastCheck", "nextCheck", "topPicks", "updated"],
      "properties": {
        "version": {"type": "integer"},
        "lastCheck": {"type": "string"},
        "nextCheck": {"type": "string"},
        "briefUrl": {"type": "string"},
        "masterUrl": {"type": "string"},
        "appUrl": {"type": "string"},
        "topPicks": {
          "type": "array", "maxItems": 3,
          "items": {"type": "object", "required": ["id", "why"], "properties": {"id": {"type": "string"}, "why": {"type": "string"}}, "additionalProperties": false}
        },
        "updated": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
